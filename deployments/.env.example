# Copiar a deployments/.env (git lo ignora) y cambiar TODOS los valores CAMBIAR.
# Contraseñas de la base: solo letras y números (van dentro de una URL y de un DSN clave=valor).
# Las contraseñas de la base solo se aplican en el primer arranque (volumen vacío);
# para cambiarlas después: docker compose down -v (borra datos) o ALTER ROLE.

URBIA_VERSION=0.1.0

POSTGRES_PASSWORD=CAMBIAR_postgres
URBIA_OWNER_PASSWORD=CAMBIAR_owner
URBIA_APP_PASSWORD=CAMBIAR_app

# Mínimo 32 caracteres. Generar en PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio_de_32+
JWT_TTL=2h

LOG_LEVEL=info
# Orígenes exactos del frontend, separados por coma, sin "/" final
CORS_ALLOWED_ORIGINS=http://localhost:5173

API_PUERTO=8080
DB_PUERTO_LOCAL=5433