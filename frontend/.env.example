# Copiar como .env (no se sube al repositorio).

# A dónde reenvía Vite las llamadas /api/... (la API Go).
VITE_PROXY_TARGET=http://localhost:8080

# Opcional: URL completa de la API si NO se usa el proxy de Vite
# (por ejemplo al publicar el build en otro servidor). Requiere CORS_ALLOWED_ORIGINS en la API.
# VITE_API_URL=http://192.168.1.50:8080

# Opcional: HTTPS para que el GPS y la instalación funcionen en celulares por la red local.
# Rutas a los archivos creados con mkcert (ver README.md).
# URBIA_HTTPS_CERT=certs/urbia.pem
# URBIA_HTTPS_KEY=certs/urbia-key.pem

# Opcional: dominios propios que pueden abrir la app además de *.trycloudflare.com,
# separados por coma (ver "Acceso desde internet" en README.md).
# URBIA_HOSTS_PERMITIDOS=urbia.midominio.mx

# Centro inicial del mapa (Celaya)
VITE_MAPA_LAT=20.5235
VITE_MAPA_LON=-100.8157
