APP_ENV=development
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s
# El backend usa urbia_app (solo CRUD); urbia_owner es solo para goose
DATABASE_URL=postgres://urbia_app:CAMBIAR_app_pass@localhost:5432/urbia?sslmode=disable&search_path=urbia,public
# Secreto para firmar JWT (mínimo 32 caracteres). Generar uno en PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio_de_32+
JWT_TTL=2h