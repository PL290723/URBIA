APP_ENV=development
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s
# El backend usa urbia_app (solo CRUD); urbia_owner es solo para goose
DATABASE_URL=postgres://urbia_app:CAMBIAR_app_pass@localhost:5432/urbia?sslmode=disable&search_path=urbia,public
# Secreto para firmar JWT (mínimo 32 caracteres). Generar uno en PowerShell:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=CAMBIAR_por_un_secreto_largo_y_aleatorio_de_32+
JWT_TTL=2h
# Servicio de inferencia (Python). Vacío = no configurado; la API arranca igual.
INFERENCE_URL=http://localhost:8000
INFERENCE_CHECK_INTERVAL=15s
INFERENCE_TIMEOUT=2s
# Contrato gRPC con el servicio de inferencia (HU 05.4). Vacío = no configurado.
INFERENCE_GRPC_ADDR=localhost:50051
INFERENCE_GRPC_TIMEOUT=10s
# Carpeta de fotografías (originales/ y procesadas/). En Docker: /app/storage (volumen)
STORAGE_DIR=./storage
# Búsqueda de reportes cercanos/duplicados (HU 06.5): radio en metros (1-1000) y ventana en días (1-365)
DUPLICADOS_RADIO_M=50
DUPLICADOS_VENTANA_DIAS=30
# Prioridad explicable (HU 07.1). Pesos PROVISIONALES: deben sumar 1 y validarse con datos reales.
PRIORIDAD_PESO_GRAVEDAD=0.40
PRIORIDAD_PESO_AFECTACION=0.30
PRIORIDAD_PESO_RECURRENCIA=0.20
PRIORIDAD_PESO_ANTIGUEDAD=0.10
# Días con los que la antigüedad llega al máximo y reportes recurrentes con los que la recurrencia llega al máximo
PRIORIDAD_ANTIGUEDAD_MAX_DIAS=30
PRIORIDAD_RECURRENCIA_MAX=4
# Fracción mínima de la fórmula que debe tener datos para asignar nivel (0.1-1)
PRIORIDAD_COBERTURA_MIN=0.50

# Seguridad (HU 09.1)
# Orígenes del frontend que pueden leer la API desde un navegador, separados por coma,
# exactos y sin "/" final (ej. http://localhost:5173,http://192.168.1.50:5173).
# Vacío = ningún navegador de otro origen. "*" no se acepta.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Intentos de login fallidos por IP antes de responder 429, y ventana de bloqueo
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA=5m