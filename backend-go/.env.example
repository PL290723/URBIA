# Copiar como .env (NO subir .env)
APP_ENV=development
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s
# El backend se conecta con urbia_app (solo CRUD), nunca con urbia_owner
DATABASE_URL=postgres://urbia_app:CAMBIAR_app_pass@localhost:5432/urbia?sslmode=disable&search_path=urbia,public